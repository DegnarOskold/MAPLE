# ============================================================
# MAPLE Environment Configuration Template
# Copy this file to .env and insert your real credentials.
# Never commit your .env file to public version control!
# ============================================================

# Telegram Bot Notifications (Optional)
# Create a bot via @BotFather on Telegram to obtain your token.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Interactive Brokers (IBKR) Account ID
IBKR_ACCOUNT_ID=your_ibkr_account_id_here
